{
  "name": "whatsapp-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local read-only WhatsApp MCP with live reads, history recovery and attachment parsing",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/patch-baileys.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@napi-rs/canvas": "1.0.10",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "exceljs": "4.4.0",
    "image-size": "2.0.4",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.4.299",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "26.6.4",
    "@types/qrcode-terminal": "0.12.2",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
