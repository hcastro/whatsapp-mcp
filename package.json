{
  "name": "whatsapp-readonly-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local selected-chat WhatsApp archive and read-only stdio MCP",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/patch-baileys.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/qrcode-terminal": "0.12.2",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
